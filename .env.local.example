# Copy this file to .env.local and fill in the values.
# None of these variables are exposed to the browser.

# Turso database (https://turso.tech)
TURSO_DB_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Stub auth passphrase (ADR-003) — single-user only
# Rotating this value invalidates all existing sessions immediately.
AUTH_PASSPHRASE=choose-a-long-random-passphrase

# pokemontcg.io API key (https://pokemontcg.io)
PTCG_API_KEY=your-pokemontcg-api-key
